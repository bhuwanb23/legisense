{
  "name": "legisense-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Legisense API — Node.js + Express (base)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/models.test.ts",
    "test:middleware": "tsx tests/middleware.test.ts",
    "test:pipeline": "tsx tests/pipeline.test.ts",
    "test:auth": "tsx tests/auth.test.ts",
    "test:documents": "tsx tests/documents.test.ts",
    "test:all": "tsx tests/models.test.ts && tsx tests/middleware.test.ts && tsx tests/pipeline.test.ts && tsx tests/auth.test.ts && tsx tests/documents.test.ts && tsx tests/queue-upgrade.test.ts && tsx tests/socket.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.110.9",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
