PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=./uploads

# Database (SQLite — file stored at data/legisense.db)

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# Mistral AI (fallback OCR when Tesseract confidence < 70%)
MISTRAL_API_KEY=

# Encryption
ENCRYPTION_KEY=

# Supabase Storage (optional — falls back to local disk if not set)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=legisense-uploads

# Background Jobs (SQLite-backed BullMQ-compatible queue)
# No Redis needed — jobs are persisted in the same SQLite database.
# Queues: document-analysis (high), ocr-processing (high),
#         notification (medium), auto-delete (low, cron), reminder (medium, cron)

# AI Providers
# Local Ollama (preferred for dev / E2E — no cloud quota)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b

# Cloud fallbacks (optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=

# Extra AI pipeline toggles
COUNTER_CLAUSES_ENABLED=false
RISK_SEMANTIC_ENABLED=false
ANALYSIS_MAX_CHARS=8000
