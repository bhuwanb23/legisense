[TEMPLATE]
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=./uploads

# ─── Database ────────────────────────────────────────────────
# Render PostgreSQL (set DATABASE_URL in Render dashboard)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# ─── Mistral AI (fallback OCR when Tesseract confidence < 70%) ─
MISTRAL_API_KEY=

# ─── Encryption (AES-256 at rest) ───────────────────────────
ENCRYPTION_KEY=

# ─── Supabase Storage (optional — falls back to local disk) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=legisense-uploads

# ─── Public URL (for share links, CORS) ─────────────────────
PUBLIC_BASE_URL=http://localhost:3001

# ─── AI Providers ───────────────────────────────────────────
# Local Ollama (set OLLAMA_ENABLED=false on Render)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:12b

# Cloud AI (set at least one on Render for analysis to work)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=

# ─── Pipeline Toggles ───────────────────────────────────────
COUNTER_CLAUSES_ENABLED=true
RISK_SEMANTIC_ENABLED=false
ANALYSIS_MAX_CHARS=8000

# ─── Email / SMTP (optional — for OTP + deadline reminders) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@legisense.app

# ─── Advanced ───────────────────────────────────────────────
AI_CALL_TIMEOUT_MS=55000
V1_ANALYZE_WAIT_MS=75000
TRANSLATE_BATCH_SIZE=8
TRANSLATE_MAX_FIELD_CHARS=600
